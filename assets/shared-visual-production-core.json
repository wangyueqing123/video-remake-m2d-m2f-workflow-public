    "mutable_location_or_terminal_state_in_identity": "BLOCK"
  },
  "p4_spatial_contract": {
    "future_scene_preflight_required": true,
    "subject_support_surface_required": true,
    "prop_support_surface_required": true,
    "open_action_path_required": true,
    "decisive_contact_reachability_required": true,
    "camera_proof_required": true,
    "occluded_critical_topology_policy": "BLOCK_NOT_VERIFIABLE"
