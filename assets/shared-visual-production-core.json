  "p6_qc_contract": {
    "per_cell_evidence_required": true,
    "critical_contact_visibility_required_when_applicable": true,
    "topology_safe_end_state_required": true,
    "style_continuity_required": true,
    "unsafe_output_may_become_reference": false
  },
  "cost_contract": {
